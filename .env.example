# Planning Pattern Market Research - Environment Variables

# Provider options: openai | huggingface (or hf) | anthropic
LLM_PROVIDER=openai

# OpenAI configuration (default path)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint override (example: Hugging Face Router)
# OPENAI_BASE_URL=https://router.huggingface.co/v1

# Hugging Face Router (OpenAI-compatible) example:
# LLM_PROVIDER=huggingface
# OPENAI_API_KEY=hf_...
# OPENAI_BASE_URL=https://router.huggingface.co/v1
# OPENAI_MODEL=moonshotai/Kimi-K2.5

# Anthropic configuration (optional fallback)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-opus-4-6

# Web search providers
# Optional: Serper key (if unset, tool falls back to DuckDuckGo + Wikipedia)
SERPER_API_KEY=

# Trajectory tracing (for training data collection)
TRACE_TRAJECTORY=true
TRACE_DIR=trajectories
